# ── Twilio WhatsApp ──────────────────────────────────────────
TWILIO_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_TOKEN=your_auth_token_here
TWILIO_FROM=whatsapp:+14155238886

# ── Your WhatsApp number(s) to receive reports ───────────────
# Comma-separated, with country code, no spaces
SUBSCRIBERS=+919XXXXXXXXX

# ── Server ───────────────────────────────────────────────────
PORT=3000

# ── Public URL of this server (for Excel file delivery) ──────
# Use ngrok for local dev: ngrok http 3000
FILE_HOST=https://your-server-domain.com

# ── Database ─────────────────────────────────────────────────
# SQLite (default, no setup needed):
# DB_PATH=./dailyxp.db
#
# Postgres (optional, for production):
# DATABASE_URL=postgresql://user:password@host:5432/dailyxp
